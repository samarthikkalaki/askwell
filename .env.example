# Askwell — copy to .env and fill in. Never commit .env.

# Supabase (public keys by design: RLS is the boundary)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only — acts as service_role and skips RLS
SUPABASE_SECRET_KEY=

# Clerk — auth and billing
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# OpenAI — chat + embeddings
OPENAI_API_KEY=

# Arcjet — rate limiting, bot protection, prompt injection
ARCJET_KEY=

# PostHog — product analytics, replay, error tracking, AI tracing
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# App
NEXT_PUBLIC_APP_URL=
# Public widget key for the widget on our own landing page (per-environment config)
LANDING_WIDGET_KEY=
